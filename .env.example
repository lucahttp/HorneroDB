##########################################
# HorneroDB Server Configuration
##########################################

# Server
SERVER_PORT=8080
HORNERO_ADMIN_URL=http://localhost:5173

# Runtime environment: "development" | "staging" | "production"
# In production the server performs fail-fast validation (see docs/SECURITY.md)
# and serves the embedded UI. docker-compose.yml sets it to "production" by
# default; leave it unset (development) for local `go run` + `npm run dev`.
# HORNERO_ENV=production

# CORS Configuration (Security)
# By default, only HORNERO_ADMIN_URL is allowed (same-origin policy)
# For multi-origin setups (e.g., admin + api + external SPAs), list all origins:
# CORS_ORIGINS=http://localhost:5173,https://api.example.com,https://app.example.com
# Note: Each workspace can define additional allowed_origins for their specific clients
# CORS_ORIGINS=

# ⚠️  HORNERO_ADMIN_URL IS A SECURITY BOUNDARY.
# It defines the allowed origin for CORS *and* the allowed origin for the
# CSRF protection of state-changing requests (POST/PUT/PATCH/DELETE).
# In production ALWAYS point it to your real admin origin, e.g.
#   HORNERO_ADMIN_URL=https://admin.mydomain.com
# Leaving it at http://localhost:5173 while the UI is served from another
# origin breaks CORS/CSRF checks for every write operation.

# Trusted reverse proxies (Security)
# Comma-separated list of IPs / CIDR ranges allowed to set the
# X-Forwarded-For and X-Forwarded-Proto headers. Leave it empty when the
# server is exposed directly (default: trust nobody).
# Behind Docker Compose / Traefik / nginx set it to the proxy network, e.g.
# TRUSTED_PROXIES=172.16.0.0/12,10.0.0.1
TRUSTED_PROXIES=

# Initial setup token (Security)
# Optional shared secret that must be provided to complete the very first
# setup of a fresh deployment. Generate with: openssl rand -base64 32
# HORNERO_SETUP_TOKEN=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
# DB_NAME must match POSTGRES_DB (see the PostgreSQL section below)
DB_NAME=hornero

# TLS mode for the PostgreSQL connection: disable | allow | prefer | require |
# verify-ca | verify-full. Production refuses "disable" unless the explicit
# escape hatch below is enabled.
DB_SSLMODE=disable

# Escape hatch for internal/trusted networks (e.g. the bundled Docker Compose
# network, where Postgres is not exposed and TLS is not available).
# DB_ALLOW_INSECURE_SSL=true allows DB_SSLMODE=disable in production.
# DB_ALLOW_INSECURE_DB=true allows the default/empty DB_PASSWORD in production.
# NEVER enable either of them on an internet-facing deployment.
DB_ALLOW_INSECURE_SSL=false
DB_ALLOW_INSECURE_DB=false

# JWT Secret (Security)
# DEVELOPMENT: If not set, a random 32-character secret is auto-generated
# PRODUCTION: REQUIRED - Must be at least 32 characters, never use default value
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# PocketID OIDC (optional)
POCKETID_ENABLED=true
POCKETID_CLIENT_ID=generated-at-pocketid-instance
POCKETID_CLIENT_SECRET=generated-at-pocketid-instance
POCKETID_ISSUER_URL=http://localhost:1411
POCKETID_REDIRECT_URL=http://localhost:8080/api/v1/auth/oidc/callback
POCKETID_API_KEY=generated-at-pocketid-instance

# S3 Storage (optional)
S3_ENABLED=false
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=hornero
S3_REGION=us-east-1
S3_USE_SSL=true

# Host port mappings used by docker-compose.yml
DB_EXTERNAL_PORT=5432
SERVER_EXTERNAL_PORT=8080




##########################################
# PostgreSQL Server Configuration
##########################################

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hornero




##########################################
# PocketID Server Configuration
##########################################

# See the documentation for more information: https://pocket-id.org/docs/configuration/environment-variables

# These variables must be configured for your deployment:
APP_URL=http://localhost:1411

# Encryption key (choose one method):
# Method 1: Direct key (simple but less secure)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Method 2: File-based key (recommended)
# Put the base64 key in a file and point to it here.
# ENCRYPTION_KEY_FILE=/path/to/encryption_key

# These variables are optional but recommended to review:
TRUST_PROXY=false
MAXMIND_LICENSE_KEY=
PUID=1000
PGID=1000

# https://localhost:1411/setup




##########################################
# Observability (OpenTelemetry + OpenObserve)
##########################################
# Opt-in: leave OTEL_EXPORTER_OTLP_ENDPOINT empty and O2_RUM_ENABLED=false to disable.
# See deploy/observability/openobserve/.env.observability.example and docs/OPERATIONS.md.

# HorneroDB Backend OTel
OTEL_SERVICE_NAME=hornerodb
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_ARG=1.0

# OpenObserve Browser RUM (runtime config via /api/v1/telemetry/config)
O2_RUM_ENABLED=false
O2_RUM_SITE=
O2_RUM_ORG=default
O2_RUM_APPLICATION_ID=hornerodb-ui
O2_RUM_CLIENT_TOKEN=
O2_RUM_SERVICE=hornerodb-ui
O2_RUM_VERSION=1.0.0
O2_RUM_SESSION_REPLAY=false

# OpenObserve & Collector Overlay (docker-compose.observability.yml)
O2_PORT=5080
O2_ORG=default
ZO_ROOT_USER_EMAIL=admin@hornerodb.local
ZO_ROOT_USER_PASSWORD=
ZO_RETENTION_DAYS=14
# Compute: O2_AUTH_HEADER="Basic $(printf '%s' 'email:pass' | base64)"
O2_AUTH_HEADER=
POSTGRES_MONITOR_USER=otel_monitor
POSTGRES_MONITOR_PASS=
