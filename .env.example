##########################################
# HorneroDB Server Configuration
##########################################

# Server
SERVER_PORT=8080
HORNERO_ADMIN_URL=http://localhost:5173

# CORS Configuration (Security)
# By default, only HORNERO_ADMIN_URL is allowed (same-origin policy)
# For multi-origin setups (e.g., admin + api + external SPAs), list all origins:
# CORS_ORIGINS=http://localhost:5173,https://api.example.com,https://app.example.com
# Note: Each workspace can define additional allowed_origins for their specific clients
# CORS_ORIGINS=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hornero
DB_SSLMODE=disable

# JWT Secret (Security)
# DEVELOPMENT: If not set, a random 32-character secret is auto-generated
# PRODUCTION: REQUIRED - Must be at least 32 characters, never use default value
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# PocketID OIDC (optional)
POCKETID_ENABLED=true
POCKETID_CLIENT_ID=generated-at-pocketid-instance
POCKETID_CLIENT_SECRET=generated-at-pocketid-instance
POCKETID_ISSUER_URL=http://localhost:1411
POCKETID_REDIRECT_URL=http://localhost:8080/api/v1/auth/oidc/callback
POCKETID_API_KEY=generated-at-pocketid-instance

# S3 Storage (optional)
S3_ENABLED=false
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=hornero
S3_REGION=us-east-1
S3_USE_SSL=true






##########################################
# PostgreSQL Server Configuration
##########################################

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hornero




##########################################
# PocketID Server Configuration
##########################################

# See the documentation for more information: https://pocket-id.org/docs/configuration/environment-variables

# These variables must be configured for your deployment:
APP_URL=http://localhost:1411

# Encryption key (choose one method):
# Method 1: Direct key (simple but less secure)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Method 2: File-based key (recommended)
# Put the base64 key in a file and point to it here.
# ENCRYPTION_KEY_FILE=/path/to/encryption_key

# These variables are optional but recommended to review:
TRUST_PROXY=false
MAXMIND_LICENSE_KEY=
PUID=1000
PGID=1000

# https://localhost:1411/setup