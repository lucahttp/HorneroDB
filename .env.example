# HorneroDB Configuration

# Server
SERVER_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hornero
DB_SSLMODE=disable

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# PocketID OIDC (optional)
POCKETID_ENABLED=false
POCKETID_CLIENT_ID=
POCKETID_CLIENT_SECRET=
POCKETID_ISSUER_URL=
POCKETID_REDIRECT_URL=http://localhost:8080/auth/pocketid/callback

# S3 Storage (optional)
S3_ENABLED=false
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=hornero
S3_REGION=us-east-1
S3_USE_SSL=true
