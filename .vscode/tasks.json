{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "go-build",
            "type": "shell",
            "command": "go build -o bin/hornerodb ./cmd/server",
            "windows": {
                "command": "go build -o bin/hornerodb.exe ./cmd/server"
            },
            "problemMatcher": [
                "$go"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "go-run",
            "type": "shell",
            "command": "./bin/hornerodb",
            "windows": {
                "command": "./bin/hornerodb.exe"
            },
            "problemMatcher": [
                "$go"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "isBackground": true
        },
        {
            "label": "npm-install",
            "type": "shell",
            "command": "npm install",
            "options": {
                "cwd": "${workspaceFolder}/web/ui"
            }
        },
        {
            "label": "npm-dev",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/web/ui"
            },
            "isBackground": true,
            "problemMatcher": [
                {
                    "pattern": [
                        {
                            "regexp": ".",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": "VITE",
                        "endsPattern": "ready in"
                    }
                }
            ]
        }
    ]
}