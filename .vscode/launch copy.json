{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Rebuild contianer and start compose",
            "command": "docker compose up -d hornerodb-server",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "Backend (Go)",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${workspaceFolder}/bin/hornerodb",
            "windows": {
                "program": "${workspaceFolder}/bin/hornerodb.exe"
            },
            "preLaunchTask": "go-build"
        },
        {
            "name": "Frontend (Vite)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/web/ui",
            "preLaunchTask": "npm-install",
            "serverReadyAction": {
                "pattern": "Local:.*(https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        }
    ],
    "compounds": [
        {
            "name": "Full Stack (Go + Vite)",
            "configurations": [
                "Backend (Go)",
                "Frontend (Vite)"
            ],
            "stopAll": true
        }
    ]
}