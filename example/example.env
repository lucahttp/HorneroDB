##########################################
# Global Domain Configuration
##########################################
DOMAIN_NAME=example.com

##########################################
# HorneroDB Server Configuration
##########################################

# Server
SERVER_PORT=80
VITE_SERVER_PUBLIC_URL=https://hornerodb.${DOMAIN_NAME}
HORNERO_ADMIN_URL=https://hornerodb.${DOMAIN_NAME}

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=hornero
DB_SSLMODE=disable

# JWT
JWT_SECRET=your_jwt_secret_base64

# PocketID OIDC (optional)
POCKETID_ENABLED=true
POCKETID_CLIENT_ID=your_pocketid_client_id
POCKETID_CLIENT_SECRET=your_pocketid_client_secret

# Modificado para usar referencias directas al dominio público!
POCKETID_ISSUER_URL=https://pocketid-sso.${DOMAIN_NAME}
POCKETID_REDIRECT_URL=${VITE_SERVER_PUBLIC_URL}/api/v1/auth/oidc/callback
POCKETID_API_KEY=your_pocketid_api_key

# S3 Storage (optional)
S3_ENABLED=false
S3_ENDPOINT=
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET=hornero
S3_REGION=us-east-1
S3_USE_SSL=true

##########################################
# PostgreSQL Server Configuration
##########################################

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=hornero

##########################################
# PocketID Server Configuration
##########################################

APP_URL=https://pocketid-sso.${DOMAIN_NAME}
ENCRYPTION_KEY=your_encryption_key_base64
TRUST_PROXY=false
MAXMIND_LICENSE_KEY=
PUID=1000
PGID=1000
