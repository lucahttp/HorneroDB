##########################################
# Observability Stack (OpenTelemetry + OpenObserve)
##########################################
# Copy the variables below into your root `.env` file, OR pass this file with:
#   docker compose --env-file .env --env-file deploy/observability/openobserve/.env.observability \
#     -f docker-compose.yml -f deploy/observability/openobserve/docker-compose.observability.yml up -d
# Never commit `.env.observability` with real secrets.

# ----------------------------------------
# OpenObserve Server
# ----------------------------------------
O2_PORT=5080
O2_ORG=default
ZO_ROOT_USER_EMAIL=admin@hornerodb.local
ZO_ROOT_USER_PASSWORD=change-me-strong-password
ZO_RETENTION_DAYS=14

# Basic auth header sent by otel-collector to OpenObserve OTLP gRPC (:5081).
# Compute with:
#   printf 'Basic %s\n' "$(printf '%s' 'admin@hornerodb.local:change-me-strong-password' | base64 -w0)"
# (On macOS/BSD base64 omit `-w0`.)
O2_AUTH_HEADER=

# ----------------------------------------
# PostgreSQL Read-Only Telemetry User
# ----------------------------------------
# Create in PostgreSQL before starting the collector:
#   CREATE USER otel_monitor WITH PASSWORD 'change-me-monitor-password';
#   GRANT pg_monitor TO otel_monitor;
POSTGRES_MONITOR_USER=otel_monitor
POSTGRES_MONITOR_PASS=change-me-monitor-password

# ----------------------------------------
# HorneroDB Backend OpenTelemetry (Opt-in)
# ----------------------------------------
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to keep telemetry disabled (noop).
OTEL_SERVICE_NAME=hornerodb
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true
# Trace head-sampling ratio between 0.0 and 1.0 (e.g. 1.0 = 100%, 0.1 = 10%)
OTEL_TRACES_SAMPLER_ARG=1.0

# ----------------------------------------
# OpenObserve Browser RUM (Opt-in, Runtime Config)
# ----------------------------------------
# Served dynamically via GET /api/v1/telemetry/config without rebuilding the UI.
# O2_RUM_CLIENT_TOKEN is a public RUM client token from OpenObserve (never an admin key).
O2_RUM_ENABLED=false
O2_RUM_SITE=
O2_RUM_ORG=default
O2_RUM_APPLICATION_ID=hornerodb-ui
O2_RUM_CLIENT_TOKEN=
O2_RUM_SERVICE=hornerodb-ui
O2_RUM_VERSION=1.0.0
O2_RUM_SESSION_REPLAY=false
